{
  "name": "@skaleagents/swarm",
  "version": "0.6.9",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "SkaleAgents review tools with OAuth for local and hosted MCP clients",
  "exports": {
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./scan": {
      "types": "./dist/iac/scan.d.ts",
      "import": "./dist/iac/scan.js"
    },
    "./review": {
      "types": "./dist/review.d.ts",
      "import": "./dist/review.js"
    }
  },
  "bin": {
    "skaleagents-swarm": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/iac/*.test.ts src/application/*.test.ts && npm run build && node --test scripts/*.test.mjs",
    "benchmark:tool": "npm run build && node scripts/benchmark-tool-latency.mjs",
    "smoke": "tsx scripts/smoke-tools.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hcl2-parser": "^1.0.3",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12"
  }
}
